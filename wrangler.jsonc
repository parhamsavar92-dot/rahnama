{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahnama",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    /* «none» یعنی Cloudflare دیگر «/x.html» را با ۳۰۷ به «/x» نفرستد.
       آن ۳۰۷ باعث ERR_FAILED در Service Worker می‌شد (توضیح کامل در src/worker.js). */
    "html_handling": "none",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rahnama-db",
      "database_id": "fe4de79b-4aa6-42bb-9239-d7a29d3fbf86"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "parham.savar92@gmail.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
