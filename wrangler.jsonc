{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahnama",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rahnama-db",
      "database_id": "fe4de79b-4aa6-42bb-9239-d7a29d3fbf86"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "parham.savar92@gmail.com"
  },
  "observability": { "enabled": true }
}
