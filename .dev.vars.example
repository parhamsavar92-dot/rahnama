# برای «npm run dev» این فایل را با نام .dev.vars کپی کنید (هرگز در گیت نگذارید)
OWNER_PASSWORD=یک-رمز-قوی-و-تازه

# ---------------------------------------------------------------- دستیار هوشمند
# هیچ‌کدام اجباری نیست. اگر هیچ‌کدام تنظیم نشود، دستیار با «موتور محلی» سایت
# از دل خودِ جزوه‌ها پاسخ می‌دهد (بدون کلید، بدون اینترنت).
#
# فقط یکی از این‌ها کافی است:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...                # OpenAI / OpenRouter / Groq / DeepSeek / Together / Ollama
# GEMINI_API_KEY=...
#
# اختیاری — برای هر سرویس سازگار با OpenAI که آدرسش با OpenAI یکی نیست:
# AI_BASE_URL=https://openrouter.ai/api/v1
#
# اختیاری — اگر چند ارائه‌دهنده تنظیم شده باشد، کدام اول امتحان شود:
# AI_PROVIDER=openai            # anthropic | openai | gemini | workersai
#
# اختیاری — نام مدل (پیش‌فرض هر ارائه‌دهنده خودکار انتخاب می‌شود):
# AI_MODEL=gpt-4o-mini
#
# اگر Workers AI را در تنظیمات Worker با نام «AI» وصل کنید، بدون کلید هم
# دستیار سروری فعال می‌شود.

# ---------------------------------------------------------------- سایر تنظیمات
# کد همکاران: تا وقتی تنظیم نشده باشد، فقط مالک می‌تواند نقش دبیر/ناظم بدهد (امن‌تر)
# STAFF_CODE=کد-همکاران
